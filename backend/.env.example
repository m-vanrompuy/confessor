# Kopieer naar `.env` in dezelfde map en vul in. `.env` zelf staat in .gitignore
# (nooit committen), dit voorbeeldbestand wel.

# Pad naar de service-account-sleutel, enkel nodig voor lokaal draaien.
# Op Cloud Run wordt dit automatisch de gekoppelde service-account (zie config.rs).
GOOGLE_APPLICATION_CREDENTIALS=secrets/service-account.json

# GCP-project waarin Firestore en Cloud Storage leven.
GOOGLE_CLOUD_PROJECT=confessions-461517

# ID van de Google Sheet gekoppeld aan het inzendformulier (te vinden in de sheet-URL).
SHEET_ID=1W_Yuo-ql5lneUYsChpH_nfBFeeisKhJaPA0bEPuWero

# Optioneel: tabblad-naam, default "Formulierreacties 1" als je dit weglaat.
# SHEET_TAB_NAME=Formulierreacties 1

# Optioneel: lokale poort, default 8080 als je dit weglaat.
# PORT=8080
