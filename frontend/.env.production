# Automatisch geladen door `vite build` (production mode, issue #74) - leeg,
# want in productie draaien frontend en backend same-origin (zelfde Cloud Run-
# service, zie backend/src/main.rs), dus werken relatieve /api-paden gewoon.
# Lokale ontwikkeling gebruikt .env (zie .env.example) met een expliciete URL.
VITE_API_BASE_URL=
